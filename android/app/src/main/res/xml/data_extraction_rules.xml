<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and above: same rule for cloud backup and phone-to-phone
     transfer. API keys are never included. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="root" path="app_flutter/nomnom/"/>
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="app_flutter/nomnom/"/>
    </device-transfer>
</data-extraction-rules>
